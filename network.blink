option ServerOutput = "src/Server/Network/init.luau"
option ClientOutput = "src/Client/Network/init.luau"

event FireWeapon {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		Direction: vector,
	}
}

event AmmoUpdated {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		Current: u8,
		Max: u8,
	}
}

event MatchUpdated {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		State: string,
		Round: u8,
		Duration: u16,
	}
}

event WeaponFired {
	From: Server,
	Type: Unreliable,
	Call: SingleSync,
	Data: struct {
		Muzzle: Instance(Attachment)?,
	}
}
